/* ------------------------------------------------------------------ */
/*  1. Оформление готовой таблицы                                      */
/* ------------------------------------------------------------------ */

function оформитьТаблицу() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const sh = ss.getSheets()[0];
  const ШАПКА = 3;                       // строка с названиями колонок
  const ПЕРВАЯ = ШАПКА + 1;
  const n = DATA.reduce((acc, g) => acc + g.items.length, 0);

  // Колонки голосов: D, F, H
  const колонкиГолосов = [4, 6, 8];

  // Выпадающий список вместо ручного ввода
  const список = SpreadsheetApp.newDataValidation()
    .requireValueInList([ДА, ОБСУДИТЬ], true)
    .setAllowInvalid(false)
    .setHelpText("Выберите «да» или «обсудить»")
    .build();
  колонкиГолосов.forEach(c => sh.getRange(ПЕРВАЯ, c, n, 1).setDataValidation(список));

  // Колонка J — итог по строке
  sh.getRange(ШАПКА, 10).setValue("Итог").setFontWeight("bold");
  const формулы = [];
  for (let r = ПЕРВАЯ; r < ПЕРВАЯ + n; r++) {
    формулы.push([
      '=IF(COUNTIF({D' + r + ';F' + r + ';H' + r + '},"' + ОБСУДИТЬ + '")>0,"обсудить",' +
      'IF(COUNTIF({D' + r + ';F' + r + ';H' + r + '},"' + ДА + '")=3,"единогласно",""))'
    ]);
  }
  sh.getRange(ПЕРВАЯ, 10, n, 1).setFormulas(формулы);

  // Цвета: зелёный — согласие, красный — на обсуждение
  const диапазон = sh.getRange(ПЕРВАЯ, 1, n, 10);
  const правила = [
    SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=$J' + ПЕРВАЯ + '="единогласно"')
      .setBackground("#E3F3EA").setRanges([диапазон]).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=$J' + ПЕРВАЯ + '="обсудить"')
      .setBackground("#FCE6E3").setRanges([диапазон]).build()
  ];
  sh.setConditionalFormatRules(правила);

  // Читаемость
  sh.setFrozenRows(ШАПКА);
  sh.setFrozenColumns(3);
  sh.getRange(ШАПКА, 1, 1, 10).setFontWeight("bold").setBackground("#2D2D87").setFontColor("#FFFFFF");
  sh.getRange(1, 1).setWrap(true).setFontStyle("italic");
  sh.setColumnWidth(1, 50);
  sh.setColumnWidth(2, 170);
  sh.setColumnWidth(3, 520);
  колонкиГолосов.forEach(c => { sh.setColumnWidth(c, 95); sh.setColumnWidth(c + 1, 200); });
  sh.setColumnWidth(10, 110);
  sh.getRange(ПЕРВАЯ, 3, n, 1).setWrap(true).setVerticalAlignment("top");
  колонкиГолосов.forEach(c => sh.getRange(ПЕРВАЯ, c, n, 1).setHorizontalAlignment("center"));

  SpreadsheetApp.flush();
  Logger.log("Готово. Оформлено строк: " + n + ". Таблица: " + ss.getUrl());
}

/* ------------------------------------------------------------------ */
/*  2. Google Форма                                                    */
/* ------------------------------------------------------------------ */

function создатьФорму() {
  const form = FormApp.create("Позиционирование — Школа английского языка Ольги Карпенко");
  form.setDescription(
    "Согласование позиционирования. По каждому утверждению выберите «" + ДА + "» " +
    "(согласен, берём как есть) или «" + ОБСУДИТЬ + "» (есть сомнение или правка).\n\n" +
    "В конце каждого раздела есть поле для комментариев — если поставили «" + ОБСУДИТЬ + "», " +
    "напишите там номер пункта и что не так. Например: «R3 — подростки приносят основные деньги, " +
    "нельзя их убирать из коммуникации».\n\n" +
    "Всего " + DATA.reduce((a, g) => a + g.items.length, 0) + " утверждений, 9 разделов. " +
    "Заполняется минут за пятнадцать."
  );
  form.setCollectEmail(false);
  form.setProgressBar(true);

  const кто = form.addMultipleChoiceItem();
  кто.setTitle("Кто отвечает").setChoiceValues(ЛЮДИ).setRequired(true);

  DATA.forEach(g => {
    form.addPageBreakItem().setTitle(g.section);

    const сетка = form.addGridItem();
    сетка.setTitle(g.section)
         .setHelpText("Отметьте по каждому пункту. Полный текст утверждений — в документе позиционирования.")
         .setRows(g.items.map(it => it[0] + ". " + сократить(it[1])))
         .setColumns([ДА, ОБСУДИТЬ]);

    form.addParagraphTextItem()
        .setTitle("Комментарии к разделу «" + g.section + "»")
        .setHelpText("По желанию. Для каждого «" + ОБСУДИТЬ + "» укажите номер пункта и что именно править.");
  });

  Logger.log("Форма для заполнения: " + form.getPublishedUrl());
  Logger.log("Редактировать форму: " + form.getEditUrl());
}

/**
 * Строки сетки в Google Формах обрезаются на длинных текстах,
 * поэтому длинные утверждения показываем первым предложением.
 */
function сократить(текст) {
  const предел = 190;
  if (текст.length <= предел) return текст;
  const точка = текст.indexOf(". ");
  if (точка > 40 && точка < предел) return текст.slice(0, точка + 1);
  return текст.slice(0, предел - 1).replace(/\s+\S*$/, "") + "…";
}
